<odoo>
    <record id="todo_task_report" model="ir.actions.report">
        <field name="name">Task Report</field>
        <field name="model">todo.task</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">todo_management.todo_task_report_template</field>
        <!--        <field name="report_file">todo_management.todo_task_report_templat</field>-->
        <field name="binding_model_id" ref="model_todo_task"/>
        <field name="binding_type">report</field>
    </record>


<template id="todo_task_report_template">
    <t t-call="web.html_container">
        <t t-call="web.external_layout">
            <t t-foreach="docs" t-as="rec">
                <style>
                    .task-box {
                        border: 2px solid #333333;
                        padding: 20px;
                        margin-top: 15px;
                    }
                    .info-table {
                        width: 100%;
                        border-collapse: collapse;
                        margin-bottom: 20px;
                    }
                    .info-table td {
                        padding: 6px 0;
                        font-size: 16px;
                    }
                    .info-label {
                        font-weight: bold;
                        width: 25%;
                    }
                    .desc-section {
                        margin-bottom: 25px;
                    }
                    .desc-title {
                        font-weight: bold;
                        font-size: 16px;
                        margin-bottom: 5px;
                    }
                    .desc-content {
                        font-size: 14px;
                        color: #333333;
                    }
                    .timesheet-table {
                        width: 100%;
                        border-collapse: collapse;
                        border: 1px solid #333333;
                        text-align: center;
                    }
                    .timesheet-table th, .timesheet-table td {
                        border: 1px solid #333333;
                        padding: 8px;
                    }
                    .timesheet-title {
                        font-size: 18px;
                        font-weight: bold;
                        text-align: center;
                        border-bottom: 1px solid #333333;
                    }
                    .timesheet-header {
                        background-color: #f0f0f0;
                        font-weight: bold;
                    }
                    .total-row {
                        font-weight: bold;
                        background-color: #f9f9f9;
                    }
                </style>

                <!-- الإطار الخارجي الكبير كما في الصورة -->
                <div class="task-box">

                    <!-- جدول البيانات الأساسية للمهمة -->
                    <table class="info-table">
                        <tr>
                            <td class="info-label">TASK:</td>
                            <td><span t-field="rec.name"/></td>
                        </tr>
                        <tr>
                            <td class="info-label">Due Date:</td>
                            <td><span t-field="rec.due_date"/></td>
                        </tr>
                        <tr>
                            <td class="info-label">Assign To:</td>
                            <td><span t-field="rec.user_id.name"/></td>
                        </tr>
                        <tr>
                            <td class="info-label">Estimated Time:</td>
                            <td><span t-field="rec.estimated_time"/> H</td>
                        </tr>
                    </table>

                    <!-- قسم الوصف Description -->
                    <div class="desc-section">
                        <div class="desc-title">Description:</div>
                        <div class="desc-content">
                            <span t-field="rec.description"/>
                        </div>
                    </div>

                    <!-- جدول الـ Timesheet -->
                    <table class="timesheet-table">
                        <thead>
                            <tr>
                                <th colspan="4" class="timesheet-title">Timesheet</th>
                            </tr>
                            <tr class="timesheet-header">
                                <th style="width: 10%;">#</th>
                                <th style="width: 25%;">Date</th>
                                <th style="width: 45%;">Description</th>
                                <th style="width: 20%;">time</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="line_num" t-value="1"/>
                            <t t-foreach="rec.line_ids" t-as="line">
                                <tr>
                                    <td><t t-esc="line_num"/></td>
                                    <td><span t-field="line.date"/></td>
                                    <td style="text-align: left; padding-left: 15px;"><span t-field="line.description"/></td>
                                    <td><span t-field="line.time"/> H</td>
                                </tr>
                                <t t-set="line_num" t-value="line_num + 1"/>
                            </t>
                        </tbody>
                        <tfoot>
                            <tr class="total-row">
                                <td colspan="3" style="text-align: center;">Total Time</td>
                                <td><span t-field="rec.total_time"/> h</td>
                            </tr>
                        </tfoot>
                    </table>

                </div>

            </t>
        </t>
    </t>
</template>
</odoo>
